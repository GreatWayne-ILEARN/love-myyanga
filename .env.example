VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY
PUBLIC_APP_URL=https://your-myyanga-domain.com

# Edge function secrets (supabase secrets set KEY=value …)
# See docs/AWS_SECRETS_RUNBOOK.md for fail-soft behaviour.

# Payments cascade (Flutterwave → Paystack → Stripe)
FLUTTERWAVE_SECRET_KEY=
PAYSTACK_SECRET_KEY=
STRIPE_SECRET_KEY=

# AI — Virtual Wear try-on (virtual-tryon edge). Set at least one:
# 1) Replicate IDM-VTON (recommended for photorealistic try-on)
REPLICATE_API_TOKEN=
# Optional override — default is yisol/IDM-VTON
REPLICATE_VTON_VERSION=906425dbca90663ff5427624839572cc8772b02c990aeeeac3a013bfcf02fe58
# 2) Gemini image editing (fallback)
GOOGLE_API_KEY=

# Google OAuth: enable provider in Supabase Auth dashboard.
# Founding super admin (migration 007 + claim_founding_owner):
#   oadeagbo@gmail.com  (FOUNDING_OWNER_EMAIL in src/lib/accessControlConstants.js)
VITE_GOOGLE_AUTH=true

SUPABASE_SERVICE_ROLE_KEY=

# Reel delivery (send-reel) — in-app inbox always works without these
RESEND_API_KEY=
REEL_EMAIL_FROM=MyYanga <reels@myyanga.com>
# Web push (optional — local Notification works in Testing)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# WhatsApp Cloud API — no BSP. OTP + optional reel fan-out.
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Staging only: expose OTP in API response when Cloud API not configured
WA_AUTH_EXPOSE_OTP=0

# Hostile audit — Tier 3 live edge tests (optional)
AUDIT_TEST_EMAIL=tester@myyanga.test
AUDIT_TEST_PASSWORD=Test2026!
# Deployed smoke test (Amplify / Netlify / custom domain)
LIVE_SITE_URL=
